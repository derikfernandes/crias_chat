rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reuniões: assunto, data, textoCompleto, userEmail (vinculação ao cadastro)
    match /meetings/{meetingId} {
      allow read, write: if true;
      // Com Firebase Auth: allow read, write: if request.auth != null && resource.data.userEmail == request.auth.token.email;

      match /items/{itemId} {
        allow read, write: if true;
      }
    }

    // Estado do chat (Telegram): userEmail (vinculação ao cadastro)
    match /chatState/{chatId} {
      allow read, write: if true;
    }
  }
}
